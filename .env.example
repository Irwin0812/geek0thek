# ============================================================
# Geek0thek - Variables d'environnement
# Copier ce fichier vers .env puis ajuster les valeurs.
#   cp .env.example .env
# ============================================================

# --- Déploiement (Debian 12 - VM cible 172.16.2.75) ----------
# IP/Interface d'écoute du frontend (reverse proxy externe ou direct)
APP_HOST_IP=172.16.2.75
APP_PORT=80

# --- Base de données PostgreSQL -------------------------------
POSTGRES_USER=vinyl
POSTGRES_PASSWORD=V4ult!Postgres2026
POSTGRES_DB=geek0thek
# Réseau interne Docker (ne pas changer sauf besoin)
DB_HOST=db
DB_PORT=5432

# --- Backend (API Express) ------------------------------------
PORT=8080
NODE_ENV=production
# OBLIGATOIRE : générer une longue chaîne aléatoire
#   openssl rand -hex 64
JWT_SECRET=REMPLACER_PAR_UN_SECRET_ALEATOIRE_LONG
JWT_EXPIRES_IN=7d
# Origine autorisée (CORS) — URL de votre reverse proxy si différente
CORS_ORIGIN=http://172.16.2.75

# --- Stockage des jaquettes -----------------------------------
# Dossier monté sur le disque de la VM hôte (volume ./uploads)
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_MB=10

# --- Google Books API -------------------------------------------------
GOOGLE_BOOKS_API_KEY=AIzaSyVotreCleGenereeIci

# --- Last.fm API -------------------------------------------------
# PRIORITÉ 1 pour la photo / logo d'artiste des disques (recherche d'artiste,
# puis artist.getInfo pour l'image du groupe). Sans clé valide, le repli passera
# directement sur Discogs / MusicBrainz.
LASTFM_API_KEY=votre-cle-lastfm-ici
LASTFM_SHARED_SECRET=votre-secret-lastfm-ici

# --- MusicBrainz API --------------------------------------------
# Aucune clé requise : l'import par code-barres utilise MusicBrainz
# (https://musicbrainz.org) + Cover Art Archive, sans authentification.
# (Optionnel) Surcharge du User-Agent identifié exigé par MusicBrainz :
MUSICBRAINZ_USER_AGENT=Geek0thek/1.0.0 (contact@example.com)

# --- Discogs API --------------------------------------------------
# En complément de MusicBrainz : la recherche par code-barres interroge
# aussi Discogs (titre, artiste, label, année, miniature, id + URL de la
# fiche). Discogs EXIGE un jeton personnel + un User-Agent identifié.
#
# Comment obtenir un jeton Discogs :
#   1. Se connecter sur https://www.discogs.com (compte gratuit requis)
#   2. Ouvrir https://www.discogs.com/settings/developers
#   3. Cliquer « Create New Token » et donner un nom (ex. « Geek0thek »)
#   4. Laisser les permissions par défaut (lecture seule suffit)
#   5. Copier le jeton généré ci-dessous
#
# Quota par défaut du jeton : 25 requêtes/min (surcharge possible dans
# DISCOGS_RATE_LIMIT_PER_MINUTE, max 250/min). Sans jeton, seule la
# recherche MusicBrainz est active.
DISCOGS_TOKEN=votre-jeton-discogs-ici
# (Optionnel) User-Agent identifié envoyé à Discogs :
DISCOGS_USER_AGENT=Geek0thek/1.0.0 (contact@example.com)
# (Optionnel) Nombre de requêtes Discogs autorisées par minute :
DISCOGS_RATE_LIMIT_PER_MINUTE=25
