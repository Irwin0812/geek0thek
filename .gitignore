# ===== Node.js / dépendances =====
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json.bak

# ===== Builds & artefacts =====
dist/
build/
*.tsbuildinfo
.vite/
.cache/
coverage/

# ===== Environnement & secrets (JAMAIS committer) =====
.env
.env.local
.env.*.local
!.env.example

# ===== Données & stockages local (VM hôte) =====
# uploads/* : tout le contenu utilisateur (avatars, vinyles, BD) reste hors git ;
# EXCEPTION : uploads/fonts/ — polices locales des thèmes (Super Comic, BD
# Cartoon Shout, Alte Haas Grotesk…) servies par le backend sous /uploads/fonts/
# et référencées par les @font-face des thèmes. Sans cette exception, `git pull`
# sur le serveur ne déploie jamais les .ttf → 404 → repli sur la police système.
uploads/*
!uploads/.gitkeep
!uploads/fonts/
data/
*.dump
*.sql.bak

# ===== Logs =====
logs/
*.log

# ===== Éditeur / OS =====
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# ===== Docker =====
# (les volumes de persistance restent sur le disque de la VM, hors dépôt git)
